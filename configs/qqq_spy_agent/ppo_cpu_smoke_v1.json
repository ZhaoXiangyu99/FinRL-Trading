{
  "experiment_name": "qqq_spy_ppo_cpu_smoke_v1",
  "purpose": "Interface and numerical-stability check only; not alpha evidence",
  "seed": 42,
  "device": "cpu",
  "total_timesteps": 4096,
  "transaction_cost_rate": 0.001,
  "reward": {
    "partial_credit": 0.25,
    "drawdown_penalty": 0.1,
    "turnover_regularizer": 0.001,
    "score_clip": 1.0
  },
  "ppo": {
    "learning_rate": 0.0003,
    "n_steps": 256,
    "batch_size": 64,
    "n_epochs": 10,
    "gamma": 1.0,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "policy_net_arch": [128, 128]
  }
}
